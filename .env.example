# Google AdSense — the only advertising system in this project.
# Copy to `.env.local` and fill in with values from your AdSense dashboard.
# Leave empty (or omit the file) and no ad markup is rendered and no script is
# loaded — the app works normally without ads.

# Publisher id, e.g. ca-pub-1234567890123456
VITE_ADSENSE_CLIENT=

# Ad unit ids, one per placement. An empty value disables that unit.
VITE_ADSENSE_SLOT_STUDIO_BOTTOM=
VITE_ADSENSE_SLOT_GALLERY_TOP=
