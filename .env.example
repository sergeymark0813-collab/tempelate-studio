# Google AdSense — the only advertising system in this project.
#
# The real publisher and slot ids are compiled in as defaults (see
# src/lib/adsense.ts) because neither is a secret: AdSense writes both into the
# markup of every page that shows an ad.
#
# These variables exist only to point a build at a different account — a fork,
# a staging site, or a test publisher. Copy to `.env.local` and fill in.

# Publisher id, e.g. ca-pub-1234567890123456
VITE_ADSENSE_CLIENT=

# Ad unit ids, one per placement. Unset means "use the compiled-in default".
VITE_ADSENSE_SLOT_STUDIO_BOTTOM=
VITE_ADSENSE_SLOT_GALLERY_TOP=
